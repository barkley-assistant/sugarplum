# Server
SUGARPLUM_PORT=3499
SUGARPLUM_HOST=127.0.0.1
SUGARPLUM_DB_PATH=./data/sugarplum.db

# Sessions
SUGARPLUM_SESSION_TTL_DAYS=30

# Bootstrap admin (required — the server refuses to boot without these).
# Only used on first boot when the users table has no admin. After the admin
# is created, user management happens in-app; env changes do not overwrite
# existing users.
SUGARPLUM_ADMIN_USERNAME=
SUGARPLUM_ADMIN_PASSWORD=
SUGARPLUM_ADMIN_DISPLAY_NAME=

# Dev toggle: set to 1 to run on plain HTTP (e.g. a LAN IP for phone testing).
# In dev mode the session cookie is sent WITHOUT the Secure attribute
# (browsers reject Secure cookies on non-localhost plain HTTP). Production is
# always HTTPS and always uses Secure cookies.
SUGARPLUM_DEV=0

# Product scraper / enrichment
# Directory where downloaded product images are stored (created on demand;
# gitignored — never commit it).
SUGARPLUM_IMAGES_DIR=./data/images
# Desktop-class user agent for the scraper. Keep it a plain browser UA —
# advertising "bot" gets Shopify-class stores to refuse.
SUGARPLUM_USER_AGENT=Mozilla/5.0 (X11; Linux x86_64; rv:130.0) Gecko/20100101 Firefox/130.0
# Max concurrent background enrichment jobs (clamped to 1..8).
SUGARPLUM_ENRICH_CONCURRENCY=2
# Optional: a self-hosted SearXNG instance for a best-effort price hint when
# a direct scrape is blocked. Leave UNSET to disable the fallback entirely.
#SUGARPLUM_SEARXNG_URL=http://192.168.0.200:35000
# Operator/test escape hatch: set to 1 to allow the scraper to fetch
# private/loopback URLs (used by the e2e suite's local fixture pages). Never
# set in production.
#SUGARPLUM_ALLOW_PRIVATE_FETCH=0

# NOTE: SESSION_SECRET is intentionally absent. Sessions are opaque
# server-side tokens stored in the database — there is nothing to sign, so no
# secret is needed. In-memory login rate limiting resets on restart.