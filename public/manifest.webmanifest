{
  "name": "sugarplum",
  "short_name": "sugarplum",
  "description": "Private wishlists, shared with people you trust.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#151022",
  "theme_color": "#151022",
  "icons": [
    { "src": "/assets/brand/pwa/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/assets/brand/pwa/icon-512.png", "sizes": "512x512", "type": "image/png" },
    {
      "src": "/assets/brand/pwa/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "/add",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": { "title": "title", "text": "text", "url": "url" }
  }
}