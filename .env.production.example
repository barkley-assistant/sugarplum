# sugarplum PRODUCTION environment file template.
# Copy to ~/.config/sugarplum/.env, then fill in the three admin variables:
#   cp .env.production.example ~/.config/sugarplum/.env && chmod 600 $_
# All variables are documented in README.md (Environment variables); this file
# lists the values the live deployment on the home server uses.

# --- Server ----------------------------------------------------------------
# Live port reserved on the host. MUST match the tunnel ingress rule
# (http://host.docker.internal:34995) and the health-check URL in deploy.sh.
SUGARPLUM_PORT=34995
# Bind ALL interfaces: the cloudflared container reaches the app via the
# host-gateway IP, so a loopback bind would be unreachable from the container.
# The systemd unit sets the same value via Environment=; if this file sets the
# var too, the FILE wins (systemd: EnvironmentFile= overrides Environment=),
# so keep both in agreement.
SUGARPLUM_HOST=0.0.0.0
# Relative paths resolve against the unit's WorkingDirectory
# (~/.local/share/sugarplum) — database and images live under its data/ dir,
# which is gitignored and backed up as a whole (sqlite + images + .env).
SUGARPLUM_DB_PATH=./data/sugarplum.db
SUGARPLUM_IMAGES_DIR=./data/images

# --- Sessions ---------------------------------------------------------------
SUGARPLUM_SESSION_TTL_DAYS=30

# --- Bootstrap admin (required on FIRST boot only) ---------------------------
# The server refuses to boot without all three set (see src/server/config.ts).
# On first boot the bootstrap admin is created from these; afterwards user
# management is in-app. Once the admin exists these are ignored — but set them
# anyway: they matter again if the DB is ever restored to an empty users table.
SUGARPLUM_ADMIN_USERNAME=
SUGARPLUM_ADMIN_PASSWORD=
SUGARPLUM_ADMIN_DISPLAY_NAME=

# --- Scraper ----------------------------------------------------------------
# Desktop-class UA — plain browser, no "bot" advertising (Shopify-class stores
# refuse bot UAs).
SUGARPLUM_USER_AGENT=Mozilla/5.0 (X11; Linux x86_64; rv:130.0) Gecko/20100101 Firefox/130.0
# Max concurrent background enrichment jobs (clamped to 1..8).
SUGARPLUM_ENRICH_CONCURRENCY=2
# Optional: self-hosted SearXNG for best-effort price hints when a direct
# scrape is blocked. Leave UNSET to disable the fallback entirely.
# The LAN address is fine: the SearXNG client uses the configured URL directly
# (the private-IP SSRF guard applies to scraped URLs, not this trusted config).
#SUGARPLUM_SEARXNG_URL=http://192.168.0.200:35000

# NOTE: SESSION_SECRET is intentionally absent. Sessions are opaque
# server-side tokens stored in the database — there is nothing to sign, so no
# secret is needed. In-memory login rate limiting resets on restart.
# NOTE: SUGARPLUM_DEV stays unset in production — Secure cookies are the
# default and the tunnel terminates TLS at Cloudflare's edge.